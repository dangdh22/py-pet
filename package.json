{
  "name": "py-pet",
  "version": "0.1.0",
  "description": "",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npm run content:build && vitest run",
    "pyodide:copy": "node tools/copy_pyodide.mjs",
    "dev": "npm run pyodide:copy && npm run content:build && vite",
    "build": "npm run pyodide:copy && npm run content:build && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "npm run content:build && tsc --noEmit",
    "test:py": ".venv/bin/python -m pytest tools/tests -q",
    "content:build": "tsx tools/build_content.ts content src/generated/content.json",
    "content:validate": "npm run content:build && python3 tools/validate_content.py src/generated/content.json",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:py && npm run content:validate && npm run test:e2e"
  },
  "keywords": [],
  "type": "module",
  "private": "true",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "codemirror": "^6.0.2",
    "dexie": "^4.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "js-yaml": "^5.4.3",
    "jsdom": "^30.1.2",
    "marked": "^18.1.0",
    "pyodide": "^314.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
